# API server
PORT=3031

# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://coffeepeppersorders.netlify.app

# WooCommerce API credentials
WOO_BASE_URL=https://coffeeandpeppers.com
WOO_CONSUMER_KEY=ck_replace_me
WOO_CONSUMER_SECRET=cs_replace_me

# Order statuses to pull (comma-separated). Use any for all statuses.
WOO_ORDER_STATUSES=processing,completed,on-hold
